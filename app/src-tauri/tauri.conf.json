{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tapkey",
  "version": "0.1.0",
  "identifier": "app.tapkey",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 352,
        "height": 320
      },
      {
        "label": "hud",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 260,
        "height": 64
      },
      {
        "label": "settings",
        "url": "index.html",
        "visible": false,
        "title": "tapkey",
        "width": 720,
        "height": 480
      },
      {
        "label": "onboarding",
        "url": "index.html",
        "visible": false,
        "title": "Welcome to tapkey",
        "width": 480,
        "height": 560,
        "resizable": false
      },
      {
        "label": "effective",
        "url": "index.html",
        "visible": false,
        "title": "What is in effect right now",
        "width": 460,
        "height": 520
      },
      {
        "label": "history",
        "url": "index.html",
        "visible": false,
        "title": "Switch history",
        "width": 460,
        "height": 520
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/tapkey-helper"
    ]
  }
}
