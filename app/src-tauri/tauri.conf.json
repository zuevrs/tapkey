{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tapkey",
  "version": "0.1.0",
  "identifier": "app.tapkey",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 380,
        "height": 320
      },
      {
        "label": "hud",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 260,
        "height": 64
      },
      {
        "label": "settings",
        "url": "index.html",
        "visible": false,
        "title": "tapkey",
        "width": 720,
        "height": 480
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
