{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tapkey",
  "version": "0.1.0",
  "identifier": "app.tapkey",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 352,
        "height": 320,
        "shadow": false
      },
      {
        "label": "hud",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "width": 280,
        "height": 64,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "index.html",
        "visible": false,
        "title": "tapkey",
        "width": 720,
        "height": 480,
        "decorations": true
      },
      {
        "label": "onboarding",
        "url": "index.html",
        "visible": false,
        "title": "Welcome to tapkey",
        "width": 480,
        "height": 660,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "effective",
        "url": "index.html",
        "visible": false,
        "title": "What is in effect right now",
        "width": 460,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "history",
        "url": "index.html",
        "visible": false,
        "title": "Switch history",
        "width": 460,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tapkey-helper"
    ]
  }
}